@model Practical_18.Application.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4 mx-auto" style="max-width: 700px;">

        <div class="card-header bg-dark text-white rounded-top-4">
            <h3 class="mb-0">Delete Student</h3>
        </div>

        <div class="card-body p-4 fs-5">

            <div class="alert alert-danger rounded-3">
                Are you sure you want to delete this student?
            </div>

            <p>
                <strong>First Name:</strong>
                @Model.FirstName
            </p>

            <p>
                <strong>Last Name:</strong>
                @Model.LastName
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

            <p>
        </div>
