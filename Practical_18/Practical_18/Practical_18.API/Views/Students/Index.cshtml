@model IEnumerable<Practical_18.Application.ViewModels.StudentViewModel>

@{
    ViewData["Title"] = "Students";
}

<h2>Students</h2>

<p>
    <a asp-action="Create" class="btn btn-dark">
        Create New Student
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.Email</td>
                <td>@student.Age</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@student.Id"
                       class="btn btn-dark">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-dark">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@student.Id"
                       class="btn btn-dark">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>